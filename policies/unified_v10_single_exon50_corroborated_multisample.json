{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_id": "geneinit_unified_rna50_se50_corroborated_multisample_v10_experimental",
  "policy_version": 10,
  "status": "EXPERIMENTAL_NOT_VALIDATED",
  "selector_schema": "geneinit_selector_policy_v1",
  "selector_core": {
    "policy_id": "geneinit_unified_rna50_se50_corroborated_multisample_v10",
    "hard_qc": {
      "common_qc_pass": 1,
      "min_protein_aa": 50,
      "single_exon_min_protein_aa": 50
    },
    "rna": {
      "min_recurrent_fraction": 0.5,
      "max_nonrecurrent_introns": null,
      "strong_min_tier": 3,
      "moderate_min_tier": 2,
      "min_samples_recurrent": 2,
      "min_replicates_strong": 2,
      "long_gene_evidence_rescue": {
        "enabled": true,
        "min_introns": 20,
        "min_recurrent_fraction": 0.8,
        "min_protein_tier": 2,
        "min_protein_chain_recall": 0.9,
        "require_retained_unique_target": true,
        "require_low_repeat": false
      }
    },
    "protein": {
      "moderate_min_tier": 2,
      "strong_min_tier": 3,
      "min_core_metric": 0.8,
      "required_terminal_matches": 2,
      "max_target_loci_per_expected_copy": 1.0,
      "uniqueness_basis": "retained_only",
      "allow_strong_unique_core_route": true
    },
    "predictor": {
      "exact_min_tier": 3,
      "require_both_predictors": true,
      "allow_exact_moderate_unique_route": true
    },
    "repeat": {
      "high_cds_fraction": 0.5,
      "severe_cds_fraction": 0.8
    },
    "graph": {
      "incompatible_relations": [
        "SAME_CHAIN",
        "HARD_OVERLAP"
      ],
      "alternative_splice": "require_unique_evidence",
      "fusion_center_survival_any": [
        "STRONG_SPANNING_JUNCTION",
        "STRONG_UNIQUE_FULL_PROTEIN"
      ],
      "fusion_center_precedence": {
        "minimum_intron_count": 2,
        "minimum_protein_chain_recall": 0.95
      },
      "base_handling": "single_admission_single_graph",
      "base_alt_current_support": {
        "min_recurrent_fraction": 0.8,
        "max_nonrecurrent_introns": 2,
        "relative_rna_min_unique_junctions_per_core_alt": 1,
        "long_gene_min_introns": 10,
        "long_gene_min_protein_cds_f1": 0.85,
        "long_gene_required_terminal_matches": 2,
        "long_gene_require_unique_target_linked": true
      }
    },
    "te_policy_id": "geneinit_te_confirmed_only_v2",
    "engine": "unified_v1",
    "rna_cds_boundary_ranking": true,
    "rna_cds_competition_ranking": true,
    "whole_model_ranking": "corroborated_multisample",
    "single_exon_min_full_cds_sample_sources": 2
  },
  "postqc_schema": "geneinit_postqc_policy_v2",
  "postqc": {
    "minimum_same_frame_overlap_bp": 3,
    "bridge_recovery": {
      "minimum_rna_tier": 2,
      "minimum_protein_tier": 2,
      "maximum_repeat_cds_fraction": 0.8,
      "exclude_active_fusion": true,
      "te_policy_id": "geneinit_te_confirmed_only_v2"
    },
    "rna_bridge_reconstruction": {
      "minimum_hq_reads": 3,
      "minimum_replicated_conditions": 1,
      "intron_length_policy": {
        "mode": "adaptive",
        "minimum_training_intron_count": 2000,
        "automatic_quantile": 0.995,
        "review_quantile": 0.999,
        "automatic_floor_bp": 5000,
        "automatic_ceiling_bp": 50000,
        "review_multiplier": 4.0,
        "review_ceiling_bp": 500000,
        "fallback_automatic_max_intron_bp": 5000,
        "fallback_review_max_intron_bp": 20000
      },
      "require_exact_exon_and_cds_boundaries": true,
      "require_complete_orf": true
    },
    "unsupported_connector": {
      "minimum_protected_neighbor_components": 2,
      "external_support_basis": "rna_or_protein_tier_ge2_or_selector_route"
    },
    "maximum_iterations": 5,
    "selection_engine": "unified_v1"
  },
  "note": "Experimental sample-provenance alternative to the v9 single-exon terminal guard. Preserve v7 admission routes, the 50-aa floor, legacy dual rank, spliced corroboration, RNA-first tie-break and fusion gate. For NEW single-exon core-fit concordance, require protein.required_terminal_matches (2) OR full-CDS support from at least single_exon_min_full_cds_sample_sources (2) distinct canonical sample-GTF files. Count each file once across all compatible isoforms and preserve every source when identical exon chains are deduplicated, including chains also found in merged RNA. Merged RNA itself is not a sample source. Sample-GTF file count is not proof of independent biological replicates, full molecules, translation or correct whole-reference protein coverage. The source inventory must map the intended sample files; duplicated biological data under different files remain an input-design issue. Missing, stale or inconsistent sample provenance is an error requiring recomputation. The core-fit threshold remains protein tier >=3 and the existing metrics >=0.8 including phase and mapped-chain recall/F1, with full-CDS RNA or self-strong coding-chain support; no new uniqueness or spliced-terminal requirement is added. The rejected v8 directional extension is disabled in this mode and remains available only under its separate experimental policy. Existing eligibility and repeat rescue are unchanged. Keep this SHA-pinned policy EXPERIMENTAL_NOT_VALIDATED and record independent whole-genome validation results in an external receipt."
}
